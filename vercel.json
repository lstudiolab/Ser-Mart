{
  "buildCommand": "echo 'Serving Ser-Mart static frontend'",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ser-mart-store.onrender.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/seller",
      "destination": "/admin.html"
    }
  ]
}
